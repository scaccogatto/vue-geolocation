{
  "name": "vue-browser-geolocation",
  "version": "3.1.0",
  "description": "Tiny, type-safe Geolocation for Vue 3 — a reactive useGeolocation() composable and standalone Promise-based helpers.",
  "author": {
    "name": "Marco Boffo",
    "email": "marcoboffo.waves@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaccogatto/vue-geolocation.git"
  },
  "bugs": {
    "url": "https://github.com/scaccogatto/vue-geolocation/issues"
  },
  "homepage": "https://github.com/scaccogatto/vue-geolocation#readme",
  "keywords": [
    "vue",
    "vue3",
    "composition-api",
    "typescript",
    "geolocation",
    "gps",
    "composable",
    "navigator",
    "coordinates"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && npm run typecheck-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build-demo": "vite build --config vite.config.demo.ts",
    "dev-demo": "vite --config vite.config.demo.ts",
    "typecheck-demo": "vue-tsc --noEmit -p tsconfig.demo.json",
    "lint:package": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "vue": "^3.2.25"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.6.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
